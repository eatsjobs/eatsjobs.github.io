{
  "name": "eatsjobs.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pasquale Mangialavori's personal site",
  "scripts": {
    "test": "node --test js/*.test.mjs js/components/*.test.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "eleventy",
    "start": "eleventy --serve"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@biomejs/biome": "2.5.8"
  }
}
